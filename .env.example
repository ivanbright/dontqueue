# Copy to `.env` and adjust. Every value is optional; defaults are shown.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# --- Database ---
# Leave POSTGRES_DB empty to use the local SQLite database. Setting it switches
# the project to PostgreSQL.
POSTGRES_DB=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# --- Queue ---
# How often the public status page polls for changes, in seconds.
POLL_INTERVAL_SECONDS=8
# Default notification channels for new queue rules (comma separated).
NOTIFICATION_DEFAULT_CHANNELS=inapp

# --- Email ---
# Leave EMAIL_HOST_USER / EMAIL_HOST_PASSWORD blank to print emails to the
# console (no credentials needed). Set both to send real mail over authenticated
# SMTP — e.g. a Gmail account with a 16-character app password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Defaults to EMAIL_HOST_USER when unset.
DEFAULT_FROM_EMAIL=
